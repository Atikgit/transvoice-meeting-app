# Copy to .env.local and fill in. Validated on server start by lib/env.ts.
# Set SKIP_ENV_VALIDATION=1 to skip the startup check (e.g. CI builds without secrets).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LiveKit ---
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
# Optional: HTTPS URL for the server SDK (RoomServiceClient). Defaults to NEXT_PUBLIC_LIVEKIT_URL in Phase 2.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- TransVoice Speech API (Triton on Azure VM) ---
TRANSVOICE_API_URL=https://your-transvoice-api.example.com
TRANSVOICE_MASTER_API_KEY=

# --- Lemon Squeezy ---
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=

# --- Internal endpoints (required from Phase 4; min 32 chars, e.g. `openssl rand -hex 32`) ---
USAGE_INGEST_SECRET=
CRON_SECRET=

# --- Upstash Redis rate limiting (required from Phase 2) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Billing config ---
BILLING_MODE=wallclock
LANG_MULTIPLIER_ENABLED=true
RECONNECT_GRACE_SEC=60
FREE_TRIAL_MINUTES=15
