# Copy to .env.local and fill in. Validated on server start by lib/env.ts.
# Set SKIP_ENV_VALIDATION=1 to skip the startup check (e.g. CI builds without secrets).
# Empty values are treated as unset.

# Public URL used in auth email links (password reset, confirmation); production:
# https://meet.transvoice.ai. Leave empty locally and on previews to use the request origin.
APP_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LiveKit ---
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
# Optional: HTTPS URL for the server SDK (RoomServiceClient). Defaults to NEXT_PUBLIC_LIVEKIT_URL in Phase 2.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- TransVoice Speech API (Triton on Azure VM) ---
TRANSVOICE_API_URL=https://your-transvoice-api.example.com
TRANSVOICE_MASTER_API_KEY=

# --- Lemon Squeezy ---
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=

# --- Internal endpoints (required from Phase 4; min 32 chars, e.g. `openssl rand -hex 32`) ---
USAGE_INGEST_SECRET=
CRON_SECRET=

# --- Live translation private beta (until the Phase 3 minute meter) ---
# Only meetings hosted by these emails get translation. Unset = the built-in default list
# (the project owner); `*` = everyone.
TRANSLATION_BETA_ALLOWLIST=codera1a1@gmail.com

# --- Translated audio cache (Phase 2B). Private Docker network only, e.g. redis://transvoice_redis:6379/2
REDIS_URL=

# --- Upstash Redis rate limiting (required from Phase 2) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Billing config ---
BILLING_MODE=wallclock
LANG_MULTIPLIER_ENABLED=true
RECONNECT_GRACE_SEC=60
# Sweeper interval in seconds (0 disables): ends abandoned sessions, closes orphan segments
SWEEP_INTERVAL_SEC=60
# The free trial amount is set in the database: private.app_settings.free_trial_minutes

# --- Signup country (analytics only, never shown in the UI) ---
# Salt for signup_ip_hash = sha256(ip + salt); min 16 chars, e.g. `openssl rand -hex 32`.
# Keep it stable: changing it makes old and new hashes incomparable. Unset → no hash stored.
IP_HASH_SALT=
# MaxMind GeoLite2 license key: Docker build arg that downloads GeoLite2-Country into /app/geoip.
# Unset → country is null (or taken from Cloudflare's CF-IPCountry header if present).
MAXMIND_LICENSE_KEY=
# Optional override of the database path (default: ./geoip/GeoLite2-Country.mmdb).
GEOIP_DB_PATH=

# --- Branded emails (Invite Partner → "Send invite by email") ---
# Use Resend, or the same SMTP server as Supabase Auth. Without either, emails go through
# Supabase's "Invite user" template and only reach people who have no account yet.
EMAIL_FROM=TransVoice AI <no-reply@transvoice.ai>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Auth providers (enable each in Supabase → Authentication → Providers first) ---
AUTH_GOOGLE_ENABLED=false
AUTH_LINKEDIN_ENABLED=false
