{
  "name": "transvoice-meeting-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "pnpm -s vad:assets && next dev",
    "build": "pnpm -s vad:assets && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "load:translate": "vitest run --config vitest.load.config.mts",
    "db:types": "supabase gen types typescript --linked --schema public > lib/supabase/database.generated.ts && prettier --write lib/supabase/database.generated.ts",
    "icons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-icons.ts",
    "auth:templates": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/push-auth-templates.ts",
    "latency:report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/latency-report.ts",
    "vad:assets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/copy-vad-assets.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@livekit/components-react": "^2.9.24",
    "@maxmind/geoip2-node": "7.1.0",
    "@ricky0123/vad-web": "0.0.31",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "6.0.0",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "nodemailer": "10.0.16",
    "onnxruntime-web": "1.30.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "undici": "7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "^26.1.0",
    "msw": "^3.0.3",
    "postcss": "^8.5",
    "prettier": "^3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    },
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
